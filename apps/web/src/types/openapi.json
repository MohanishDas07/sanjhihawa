  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check Health",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/geocode": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "Geocode City",
        "operationId": "geocode_city_api_v1_geocode_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "City name to search",
              "default": "Ghaziabad",
              "title": "Q"
            },
            "description": "City name to search"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/air": {
      "get": {
        "tags": [
          "Air Quality"
        ],
        "summary": "Get Air",
        "operationId": "get_air_api_v1_air_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 90.0,
              "minimum": -90.0,
              "description": "Latitude",
              "default": 28.6692,
              "title": "Lat"
            },
            "description": "Latitude"
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 180.0,
              "minimum": -180.0,
              "description": "Longitude",
              "default": 77.4538,
              "title": "Lon"
            },
            "description": "Longitude"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "City name",
              "default": "Ghaziabad",
              "title": "City"
            },
            "description": "City name"
          },
          {
            "name": "fallback",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Force labeled offline sample fixture",
              "default": false,
              "title": "Fallback"
            },
            "description": "Force labeled offline sample fixture"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirQualityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
