{
  "openapi": "3.1.0",
  "info": {
    "title": "Saans API - Clean Air Intelligence & Breath Budget Engine",
    "description": "Deterministic exposure engine, CPCB AQI calculator, and AI tool interface.",
    "version": "1.0.0"
